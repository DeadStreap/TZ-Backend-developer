generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int    @id @default(autoincrement())
  sku      String @unique
  name     String
  type     String // topup | key | subscription | giftcard
  price    Float
  currency String @default("RUB")
  image    String?

  keys Key[]
}

model Key {
  id       Int       @id @default(autoincrement())
  sku      String
  code     String    @unique
  status   String    @default("available") // available | reserved | issued
  orderId  String?   @unique
  issuedAt DateTime?

  order   Order?   @relation(fields: [orderId], references: [orderId])
  product Product  @relation(fields: [sku], references: [sku])

  @@index([sku, status])
}

model Order {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  sku       String
  status    String   @default("created") // created | paid | delivering | delivered | payment_failed | out_of_stock | delivery_failed
  amount    Float
  currency  String   @default("RUB")
  keyId     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key      Key?
  payments Payment[]
}

model Payment {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique // Идемпотентность!
  orderId     String
  status      String   // paid | failed
  amount      Float
  processedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [orderId])

  @@index([orderId])
}

model DeliveryAttempt {
  id        Int      @id @default(autoincrement())
  requestId String   @unique // "{orderId}-{attempt}"
  orderId   String
  sku       String
  code      String?  // выданный код (null если таймаут без ответа)
  supplier  String
  status    String   // ok | timeout | error
  createdAt DateTime @default(now())

  @@index([requestId])
}

model PromoCode {
  id        Int    @id @default(autoincrement())
  code      String @unique
  type      String // percent | amount
  value     Float
  currency  String @default("RUB")
  maxUses   Int
  usedCount Int    @default(0)
  active    Boolean @default(true)
}
